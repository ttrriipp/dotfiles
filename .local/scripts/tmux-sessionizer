#!/usr/bin/env bash

if [[ $# -eq 1 ]]; then
    selected=$1
else
    selected=$(find ~/repos "/mnt/c/Users/ironm/Windows Repos/" -mindepth 1 -maxdepth 1 -type d | fzf)
fi

if [[ -z $selected ]]; then
    exit 0
fi

# Sanitize: replace spaces, dots, and other tmux-unsafe chars with underscores
selected_name=$(basename "$selected" | tr ' .' '_' | tr -cd '[:alnum:]_-')

tmux_running=$(pgrep tmux)

if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
    tmux new-session -s "$selected_name" -c "$selected"
    exit 0
fi

# Use exact matching with '=' prefix and quote the name
if ! tmux has-session -t "=$selected_name" 2>/dev/null; then
    tmux new-session -d -s "$selected_name" -c "$selected"
fi

if [[ -z $TMUX ]]; then
    tmux attach -t "=$selected_name"
else
    tmux switch-client -t "=$selected_name"
fi
